{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hygienenote-gingival-ioe.schema.json",
  "title": "HygieneNote Gingival and IOE Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogId",
    "source",
    "implementationPolicies",
    "normalizedSections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "catalogId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "documentName",
        "sourceTables"
      ],
      "properties": {
        "documentName": {
          "type": "string"
        },
        "sourcePages": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "sourceTables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceTable"
          }
        }
      },
      "additionalProperties": true
    },
    "implementationPolicies": {
      "type": "object"
    },
    "sharedModels": {
      "type": "object"
    },
    "normalizedSections": {
      "type": "object",
      "required": [
        "gingivalDescription",
        "ioe"
      ],
      "properties": {
        "gingivalDescription": {
          "$ref": "#/$defs/gingivalSection"
        },
        "ioe": {
          "$ref": "#/$defs/ioeSection"
        }
      },
      "additionalProperties": false
    },
    "reviewItems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "sourceTable": {
      "type": "object",
      "required": [
        "tableId",
        "headers",
        "rows"
      ],
      "properties": {
        "tableId": {
          "type": "string"
        },
        "sourceTableNumber": {
          "type": "integer"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "statusOption": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "catalogOption": {
      "type": "object",
      "required": [
        "id",
        "label",
        "classification",
        "noteFragment",
        "sourceCategory",
        "sourceTerm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "normal",
            "normal_variation",
            "abnormal"
          ]
        },
        "noteFragment": {
          "type": "string"
        },
        "sourceCategory": {
          "type": "string"
        },
        "sourceTerm": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "dimension": {
      "type": "object",
      "required": [
        "id",
        "label",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogOption"
          }
        }
      },
      "additionalProperties": true
    },
    "gingivalSection": {
      "type": "object",
      "required": [
        "id",
        "label",
        "dimensions",
        "wnlPreset"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          }
        },
        "wnlPreset": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "ioeStructure": {
      "type": "object",
      "required": [
        "id",
        "label",
        "implementationMode",
        "statusOptions",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "implementationMode": {
          "type": "string"
        },
        "statusOptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statusOption"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogOption"
          }
        }
      },
      "additionalProperties": true
    },
    "ioeSection": {
      "type": "object",
      "required": [
        "id",
        "label",
        "structures"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "structures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ioeStructure"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
