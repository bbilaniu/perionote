{
  "name": "hygienenote",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev .next-dev",
    "dev:e2e": "node scripts/run-next.mjs dev .next-playwright --port 3100",
    "build": "node scripts/build-next.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset tag",
    "versioning:check": "node scripts/check-versioning.mjs",
    "catalogue:from-cleardent": "node scripts/transform-cleardent-catalogue.mjs",
    "codex:patches:prepare": "node scripts/codex-patch-branches.mjs prepare",
    "codex:patches:configure": "node scripts/codex-patch-branches.mjs configure",
    "codex:patches:apply": "node scripts/codex-patch-branches.mjs apply",
    "beta:sync": "git fetch origin && git switch beta && git merge --ff-only origin/main && git push origin beta"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
